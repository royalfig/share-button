{
  "name": "@royalfig/share-button",
  "description": "Adds a web-component share button to your website",
  "version": "2.1.5",
  "type": "module",
  "private": false,
  "packageManager": "pnpm@11.28.12",
  "files": [
    "dist"
  ],
  "module": "./dist/share-button.es.js",
  "main": "./dist/share-button.umd.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/share-button.es.js",
      "require": "./dist/share-button.umd.js"
    }
  },
  "license": "MIT",
  "author": {
    "name": "Ryan Feigenbaum",
    "url": "https://ryanfeigenbaum.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royalfig/share-button.git"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write ./src",
    "check": "biome format ./src",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "prerelease": "(git diff --quiet HEAD || git commit -am \"publish\") && npm version patch && git push && git push --tags"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@vitest/browser": "^5.1.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "stylelint": "^18.0.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
